# Trim the build context. The image only needs the Node sources, the skill, the
# installers and the docker/ scripts themselves.

# VCS
.git

# dependencies (the project has none, but never ship a stray tree)
node_modules

# build output
dist
*.tgz

# the frontend's build product — `dist` above does NOT cover it (a bare name matches at the
# context root, not at `web/dist`). Kept out of the image so the `webbuild` stage's own
# `vite build` is the *only* thing that writes `/app/web/dist`: a directory COPY merges, so
# a host-built `web/dist` would otherwise land beside the fresh one — with its own hashed
# chunk names, which an `emptyOutDir` in the build stage cannot remove. That mixture is what
# makes a stale local build poison an otherwise clean image (docker/Dockerfile).
web/dist

# runtime state — bind-mounted at run time via docker-compose.yml, never baked in
.data

# the loop's per-task process directories (card.md, notes, attachments) — never image input
.meerkat

# the install-root config file — it may hold TASKD_TOKEN, and `COPY . .` would
# otherwise bake it into the image. Compose points MEERKAT_TASKPANEL_ENV_FILE at
# the writable data volume instead.
.env
# per-kind configs — machine-local, never image input
.env.*

# parallel-task worktrees (CLAUDE.md keeps them inside the checkout) — another branch's
# whole tree must never enter this build context
.worktrees

# test / coverage output
coverage

# not needed inside the image
design

# macOS
.DS_Store

# logs
*.log
