# Meerkat TaskPanel — the configuration surface, in one place.
#
# This file is the **inventory**, not a file to load: it names every key the
# application reads, grouped by where that key actually lands. A real install
# writes two files — the shared `.env` at the install root (copied from
# `scripts/install/templates/env.example`) and the per-agent-kind
# `.env.<actor-kind>` at the program root (copied from
# `scripts/install/templates/agent/meerkat-taskpanel.env`). Both are subsets of
# this list, and `test/contract/config-keys.test.mjs` holds both directions: a
# key read but not named here is a defect, and a key named here that nothing
# reads is dead configuration.
#
# Resolution order, per key: a command-line flag, then the process environment,
# then the per-kind file, then the shared `.env`, then the built-in default. The
# loader validates the file at startup and refuses an unknown key in these
# namespaces (`CONFIG_FILE_INVALID`), so a typo fails loudly instead of being
# ignored.
#
# Reload: only the SLA table and the access policy are re-read while the process
# runs — a hand edit applies to the next pass or request. Every other key is read
# once at start and needs a restart. Keep the file 0600 when it holds an inline
# token.
#
# Full topology and operator steps: docs/ops/install.md. Loop policy in prose:
# docs/ops/install.md § "Scheduling units".

# ─────────────────────────────────────────────────────────────────────────────
# Shared configuration — <install root>/.env. Read by taskd, taskctl and the loop.
# ─────────────────────────────────────────────────────────────────────────────

# The board's preferred address. A dead loopback address may still fall through to
# the machine's running board or a lazy start; a dead remote address is an error.
# `--url` remains an explicit pin. Default: http://localhost:9527.
# TASKD_URL=http://localhost:9527

# Client credential, inline. Keep exactly one of this and TASKD_TOKEN_FILE; both is
# a startup error. Never commit it.
# TASKD_TOKEN=td_...

# Client credential, read from a file. The file must be 0600. Prefer this on a
# shared machine; TASKD_TOKEN outranks it when a shell exports one for a command.
# TASKD_TOKEN_FILE=/absolute/path/to/token

# Set to 1 to stop taskctl from spawning a taskd on demand (tests, a remote board).
# TASKD_NO_AUTOSTART=1

# Where a locally started board keeps its SQLite database, logs and writer lock.
# Default: <repo>/.data.
# TASKD_DATA_DIR=/absolute/path/to/.data

# The database file itself; wins over TASKD_DATA_DIR. Default: <dataDir>/board.sqlite.
# TASKD_DB=/absolute/path/to/board.sqlite

# The runtime pointer file taskctl reads to find a running board. Overriding it is
# how a test or a second board avoids the machine-wide slot.
# TASKD_RUNTIME_POINTER=/absolute/path/to/runtime.json

# The address taskd binds. Default: 127.0.0.1 (loopback only).
# TASKD_HOST=0.0.0.0

# The port taskd binds. Default: 9527.
# TASKD_PORT=9527

# Turn the CIDR allow-list on. The Access panel writes this key on save.
# TASKD_ALLOW_LIST_ENABLED=true

# Comma-separated CIDRs allowed past the allow-list. Empty means "no address
# outside loopback", which is the safe reading.
# TASKD_ALLOW_CIDRS=192.168.0.0/16,10.0.0.0/8

# Run the label garbage collector. Default: off.
# TASKD_LABEL_GC=on

# Days an unused label is kept before the collector drops it. Default: 30.
# TASKD_LABEL_TTL_DAYS=30

# Log level for taskd (and for taskctl and the loop, which are silent unless asked).
# One of debug, info, warn, error, off. Default: info. An invalid value is refused.
# TASKD_LOG_LEVEL=info

# Largest taskd.log before rotation. Default: 10485760 (10 MiB).
# TASKD_LOG_MAX_BYTES=10485760

# Rotated log files kept. Default: 5.
# TASKD_LOG_KEEP=5

# Default agent name for a taskctl call that names none. A team passes
# `--agent jobs|linus|turing` per call instead.
# TASKCTL_AGENT=claude

# Human display name. taskd uses it as the actor for a request carrying no
# X-Taskctl-Actor header (the browser UI, curl).
# TASKCTL_HUMAN=Your Name

# SLA table — working minutes. taskd validates these, publishes the effective
# table on GET /api/v1/sla, and the loop re-reads it every pass, so a hand edit
# applies without a restart. Working hours (09:00-23:00 Asia/Shanghai) are fixed
# and not configurable. Design: docs/sla.md §2.

# How often the loop measures, in seconds. Default: 300.
# TASKD_SLA_PERIOD_SECONDS=300

# How far back the leader looks for a prior card. Default: 7 (days).
# TASKD_SLA_LEADER_LOOKBACK_DAYS=7

# The peer-watchdog period. Default: 15 (minutes).
# TASKD_SLA_PEER_PERIOD_MIN=15

# Missed peer periods before a peer counts as silent. Default: 3.
# TASKD_SLA_PEER_LIVENESS_K=3

# A card waiting on a clarification alerts at this age.
# TASKD_SLA_BLOCKED_CLARIFICATION_LIMIT_MIN=120
# The same card escalates at this age.
# TASKD_SLA_BLOCKED_CLARIFICATION_FURTHER_MIN=1440

# A card waiting at a confirmation gate alerts at this age.
# TASKD_SLA_CONFIRMATION_GATE_LIMIT_MIN=240
# The same card escalates at this age.
# TASKD_SLA_CONFIRMATION_GATE_FURTHER_MIN=1440

# A defect reported but not carded alerts at this age.
# TASKD_SLA_DEFECT_CARD_CREATION_LIMIT_MIN=1440
# The same defect escalates at this age.
# TASKD_SLA_DEFECT_CARD_CREATION_FURTHER_MIN=2880

# An acceptance waiting to be carded alerts at this age.
# TASKD_SLA_ACCEPTANCE_CARD_CREATION_LIMIT_MIN=1440
# The same acceptance escalates at this age.
# TASKD_SLA_ACCEPTANCE_CARD_CREATION_FURTHER_MIN=2880

# A claimed card whose heartbeat is stale alerts at this age.
# TASKD_SLA_HEARTBEAT_STALE_LIMIT_MIN=30
# The same claim escalates at this age.
# TASKD_SLA_HEARTBEAT_STALE_FURTHER_MIN=360

# A leader that has stopped making progress alerts at this age.
# TASKD_SLA_LEADER_STALLED_LIMIT_MIN=60
# The same stall escalates at this age.
# TASKD_SLA_LEADER_STALLED_FURTHER_MIN=360

# ─────────────────────────────────────────────────────────────────────────────
# Loop policy — <program root>/.env.<actor-kind>. Read by taskctl loop against a
# per-agent-kind config; the board loader ignores these keys by design.
# ─────────────────────────────────────────────────────────────────────────────

# Worker kinds this loop dispatches. Default: TASKCTL_AGENT.
# MEERKAT_TASKPANEL_AGENTS=claude

# Full tool access for every dispatched session. Off unless both this and the
# reason below are set — turning it on gives sessions the installing user's full
# OS permissions, and the project directory is not an isolation boundary.
# MEERKAT_TASKPANEL_ALLOW_ALL_TOOLS=yes

# Who authorized full tool access and why. At least 8 characters when set.
# MEERKAT_TASKPANEL_ALLOW_ALL_TOOLS_REASON="<who authorized it and why>"

# Also claim cards with no assignee. Default: no.
# MEERKAT_TASKPANEL_CLAIM_UNASSIGNED=yes

# Enable the continue turn. Default: no.
# MEERKAT_TASKPANEL_CONTINUE=yes

# Seconds between continue turns. Default: 600.
# MEERKAT_TASKPANEL_CONTINUE_INTERVAL=600

# Minimum gap before an event nudges the continue clock, in milliseconds.
# MEERKAT_TASKPANEL_EVENT_CONTINUE=5000

# Subagents dispatched at once; workers and reviewers share it. Default: 8.
# MEERKAT_TASKPANEL_MAX_CONCURRENCY=8

# Seconds between liveness pulses. Default: 60. A pulse reads no board.
# MEERKAT_TASKPANEL_PING_INTERVAL=60

# Live subagents allowed in one project. Unset means MAX_CONCURRENCY.
# MEERKAT_TASKPANEL_PROJECT_CONCURRENCY=4

# Close a project session after this much idleness, in milliseconds. Default: 1800000.
# MEERKAT_TASKPANEL_PROJECT_IDLE_MS=1800000

# Also recover stale in-progress claims (same holder 30 min, any agent 6 h). Default: no.
# MEERKAT_TASKPANEL_RECOVER_STALE=yes

# Where the board engine (taskctl) lives for this loop. Set by the installer; a
# re-install re-points it. Not needed when the loop runs beside a checkout.
# MEERKAT_TASKPANEL_REPO=/absolute/path/to/meerkat-taskpanel

# Minutes before an untouched review card is aged into the workflow pass.
# MEERKAT_TASKPANEL_REVIEW_AGING_MINUTES=1440

# The independent reviewer's agent name. Empty means no review dispatch. Default: Reviewer.
# MEERKAT_TASKPANEL_REVIEWER=Reviewer

# Where the team's roles (ownership.md and the workflows) live. Falls back to
# <project>/.meerkat/roles/, then the installed skill's own roles directory.
# MEERKAT_TASKPANEL_ROLES_DIR=/absolute/path/to/roles

# Seconds a resident session lives. 0 means never expire. Default: 86400.
# MEERKAT_TASKPANEL_SESSION_MAX_AGE=86400

# Queue poll interval for the session pool, in milliseconds. Default: 1000.
# MEERKAT_TASKPANEL_SESSION_POLL_MS=1000

# Max project sessions held at once. Default: 8.
# MEERKAT_TASKPANEL_SESSION_POOL_MAX=8

# Seconds for one session turn. Must be 1200..7199: a shorter turn starves workers,
# a longer one outlives the ledger's two-hour reap. Default: 1800.
# MEERKAT_TASKPANEL_SESSION_TURN_TIMEOUT=1800

# The agent that speaks for the leader in the SLA peer watchdog.
# MEERKAT_TASKPANEL_SLA_LEADER=Leader

# The agent that speaks for a peer in the SLA peer watchdog.
# MEERKAT_TASKPANEL_SLA_PEER=Peer

# Run dispatched subagents in the background. On by default where the host survives.
# MEERKAT_TASKPANEL_SUBAGENT_BACKGROUND=yes

# Run the review workflow pass. Default: no.
# MEERKAT_TASKPANEL_WORKFLOW=yes

# Actions the workflow pass may take in one round. Default: 1.
# MEERKAT_TASKPANEL_WORKFLOW_MAX_ACTIONS=1

# Where a dispatched session works: worktree (isolated, the default) or shared.
# MEERKAT_TASKPANEL_WORKSPACE=worktree

# ─────────────────────────────────────────────────────────────────────────────
# Locators — process environment only. They name a *file*, so they cannot be
# written inside the file they locate.
# ─────────────────────────────────────────────────────────────────────────────

# The shared config file taskd, taskctl and the loop read instead of <install root>/.env.
# MEERKAT_TASKPANEL_ENV_FILE=/absolute/path/to/.env

# The config root that holds projects.json and the per-kind files. Relocated by
# tests, containers and read-only installs.
# MEERKAT_TASKPANEL_CONFIG_DIR=/absolute/path/to/config

# ─────────────────────────────────────────────────────────────────────────────
# Injected by the agent shim on every call — never written by hand, and stripped
# from a spawned taskd's environment.
# ─────────────────────────────────────────────────────────────────────────────

# The actor kind of the calling agent (claude, codex, pi, openclaw). Injected per call.
# TASKCTL_ACTOR_KIND=claude

# The calling agent session id, carried so a write stays traceable. Injected per call.
# TASKCTL_SESSION_ID=<session>

# The agent platform the shim runs under, when it differs from the actor kind.
# TASKCTL_AGENT_PLATFORM=claude
