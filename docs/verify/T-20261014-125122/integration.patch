++  const parent = mk("TD-125", { title: "Parent card", status: "in_progress" });
++  const blocksA = mk("TD-130", { title: "Blocked card A", status: "blocked" });
++  const blocksB = mk("TD-126", { title: "Blocked card B", status: "blocked" });
