++  if (hit === undefined) return fallback;
++  if (hit.includes("=")) return hit.slice(hit.indexOf("=") + 1);
++  const next = process.argv[process.argv.indexOf(hit) + 1];
++  return next === undefined || next.startsWith("--") ? true : next;
