{
  "name": "meerkat-taskpanel",
  "version": "0.1.1",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "description": "Task management board for AI Agent teams.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "meerkat-taskpanel": "./scripts/install/cli.mjs",
    "taskctl": "./src/cli/index.mjs",
    "taskd": "./src/server/main.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./.pi/extensions/meerkat-taskpanel.ts"
    ]
  },
  "files": [
    "src",
    "skills",
    "web/dist",
    ".claude-plugin",
    ".pi",
    "scripts",
    "docs",
    "install.sh",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:web": "npm -w web run build",
    "dev:web": "npm -w web run dev",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
"verify": "node scripts/verify/manifests.mjs && node scripts/verify/skill.mjs && node scripts/verify/migrations.mjs && node scripts/verify/paths.mjs && node scripts/verify/signposts.mjs && node scripts/verify/web-dist.mjs --build",
    "verify:web-dist": "node scripts/verify/web-dist.mjs --build --require=all",
    "verify:migrations": "node scripts/verify/migrations.mjs",
    "verify:changelog": "node scripts/verify/changelog.mjs",
    "release:bump": "node scripts/release/bump.mjs",
    "test": "node --test",
    "check": "npm run verify && npm test",
    "verify:docker": "node scripts/verify/docker.mjs",
    "verify:docker:container": "bash docker/verify-in-container.sh",
    "test:coverage": "node --test --test-reporter=tap --experimental-test-coverage --test-coverage-include='src/core/**' --test-coverage-include='src/foundation/**' --test-coverage-include='src/cli/**' --test-coverage-include='src/server/**' --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80"
  },
  "keywords": [
    "task-management",
    "ai-agent",
    "kanban",
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tanyu216/meerkat-taskpanel.git"
  }
}
