# Meerkat TaskPanel patrol service — generated by `install.sh`.
#
# One patrol pass: escalate stale in_progress claims, and report a heartbeat that
# cannot be read. No LLM turn by default. Driven by meerkat-taskpanel-patrol.timer (300s).
[Unit]
Description=Meerkat TaskPanel supervisor patrol pass ({{AGENT}} on {{HOST}})

[Service]
Type=oneshot
ExecStart=/usr/bin/env node {{SUPERVISOR}} --host {{HOST}} --agent {{AGENT}} --patrol-only --once --log {{LOG}} --state {{STATE}}
StandardOutput=append:{{LOG}}
StandardError=append:{{LOG}}
