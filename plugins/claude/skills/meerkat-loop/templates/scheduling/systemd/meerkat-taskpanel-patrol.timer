# Meerkat TaskPanel patrol timer — generated by `install.sh`. Fires the patrol service
# every five minutes (the fallback layer).
[Unit]
Description=Meerkat TaskPanel patrol timer (every 300s)

[Timer]
OnBootSec=90s
OnUnitActiveSec=300s
Unit=meerkat-taskpanel-patrol.service

[Install]
WantedBy=timers.target
