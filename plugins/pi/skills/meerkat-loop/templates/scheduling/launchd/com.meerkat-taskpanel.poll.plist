<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Meerkat TaskPanel poll unit — generated by `install.sh`. Runs one supervisor tick a
     minute: a $0 candidate scan, an atomic claim, and a worker wake only when a
     card was actually claimed. `install.sh` prints the launchctl command to load
     it; nothing is loaded automatically. Logs append to {{LOG}}.

     ProgramArguments[0] is the ABSOLUTE node that rendered this plist — never
     `/usr/bin/env node`, which launchd resolves against the job's PATH
     (`/usr/bin:/bin:/usr/sbin:/sbin`, holding no nvm and no Homebrew directory) and
     which therefore exits 127 on any machine whose node lives only there. PATH below
     does the same job for everything the tick *derives*: the wake glue's `exec claude`
     resolves the host CLI by name, and so does the worker's own process tree. It
     prepends those directories to launchd's default rather than replacing it, so a
     child that asks for `sh` or `git` still finds them. Both are version-pinned: after
     a node or CLI upgrade, run `install.sh --force` to refresh this plist. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.meerkat-taskpanel.{{AGENT}}.{{HOST}}.poll</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE}}</string>
    <string>{{SUPERVISOR}}</string>
    <string>--host</string>
    <string>{{HOST}}</string>
    <string>--agent</string>
    <string>{{AGENT}}</string>
    <string>--once</string>
    <string>--log</string>
    <string>{{LOG}}</string>
    <string>--state</string>
    <string>{{STATE}}</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{UNIT_PATH_LAUNCHD}}</string>
  </dict>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>{{LOG}}</string>
  <key>StandardErrorPath</key>
  <string>{{LOG}}</string>
</dict>
</plist>
