# Meerkat TaskPanel per-kind configuration — generated by `install.sh`.
#
# Read by `taskctl` as a per-agent default layer, and by `taskctl run` for the
# loop policy below. A command-line flag or the process environment overrides any key.
#
#   MEERKAT_TASKPANEL_AGENT_KIND_ORDER      the install-time loop-kind preference order
#                                           (first = primary); a kind it omits is appended
#   MEERKAT_TASKPANEL_CLAIM_UNASSIGNED      yes|no — also claim unassigned cards
#   MEERKAT_TASKPANEL_RECOVER_STALE         yes|no — also recover stale in_progress claims
#                                           (same holder 30 min; past 6 h the
#                                           assignee, anyone else --allow-steal)
#   MEERKAT_TASKPANEL_REPO                  where the board engine (`taskctl`) lives
#   MEERKAT_TASKPANEL_WORKFLOW              yes|no — run the review workflow pass
#   MEERKAT_TASKPANEL_PING_INTERVAL         seconds, default 60 (liveness; no board read)
#   MEERKAT_TASKPANEL_CONTINUE_INTERVAL     seconds, default 600 (judgment clock)
#   MEERKAT_TASKPANEL_CONTINUE              yes|no — enable the continue turn
#
# The resident session pool (`taskctl pool`, the session unit). The pool
# is always available; `--resident=no` is the deliberate per-invocation opt-out,
# and it is a flag rather than a key so no install writes one.
#   MEERKAT_TASKPANEL_SESSION_MAX_AGE       seconds, default 86400; 0 = never expire
#   MEERKAT_TASKPANEL_SESSION_TURN_TIMEOUT  seconds, default 3600 (one turn);
#                                           must be 1200..7199 — a shorter turn
#                                           starves workers, a longer one outlives
#                                           the ledger's 2-hour reap
#   MEERKAT_TASKPANEL_SESSION_POLL_MS       queue poll interval, default 1000
#   MEERKAT_TASKPANEL_MAX_CONCURRENCY       subagents at once, default 8 — workers and
#                                           reviewers share it; the split follows demand
#   MEERKAT_TASKPANEL_SESSION_POOL_MAX      max project sessions, default 8
#   MEERKAT_TASKPANEL_PROJECT_CONCURRENCY   live subagents per project; unset = --max-concurrency
#   MEERKAT_TASKPANEL_PROJECT_IDLE_MS       default 1800000 (30 min); close an idle project session
#
# Every dispatched session runs with the full tool set; the reviewer's write
# tools are denied. The project directory is not an isolation boundary.
#
# The repo path is recorded because the body is copied into the agent directory while the
# board engine stays in the checkout. Re-running `install.sh` re-points this key;
# a loaded unit needs no reload.
MEERKAT_TASKPANEL_AGENT_KIND_ORDER={{KIND_ORDER}}
MEERKAT_TASKPANEL_CLAIM_UNASSIGNED={{CLAIM_UNASSIGNED}}
MEERKAT_TASKPANEL_RECOVER_STALE={{RECOVER_STALE}}
MEERKAT_TASKPANEL_REPO={{REPO}}
MEERKAT_TASKPANEL_WORKFLOW={{WORKFLOW}}
MEERKAT_TASKPANEL_PING_INTERVAL={{PING_INTERVAL}}
MEERKAT_TASKPANEL_CONTINUE_INTERVAL={{CONTINUE_INTERVAL}}
MEERKAT_TASKPANEL_CONTINUE={{CONTINUE}}
MEERKAT_TASKPANEL_SESSION_MAX_AGE=86400
MEERKAT_TASKPANEL_SESSION_TURN_TIMEOUT=3600
MEERKAT_TASKPANEL_SESSION_POLL_MS=1000
MEERKAT_TASKPANEL_SESSION_POOL_MAX=8
MEERKAT_TASKPANEL_PROJECT_IDLE_MS=1800000
