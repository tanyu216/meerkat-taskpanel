# Meerkat TaskPanel — install-root configuration.
# Read by taskd, taskctl and the loop's SSE subscriber.
# The process environment wins key by key. Keep this file 0600 if it holds a
# token: `TASKD_TOKEN` inline makes it a secret file.
#
# Only this simple KEY=VALUE form is understood: no inline comments, no
# interpolation, no escapes, no multiline values. Comments start with `#`.

# The board's preferred address. A dead loopback address may still fall through
# to the machine's running board or a lazy start; a dead remote address is an
# error. `--url` remains an explicit pin.
TASKD_URL=http://localhost:9527

# Client credential. Keep exactly one of these two.
# TASKD_TOKEN=td_...
# TASKD_TOKEN_FILE=/absolute/path/to/token

# Local board settings (used when the CLI starts one).
# TASKD_DATA_DIR=/absolute/path/to/.data
# TASKD_DB=/absolute/path/to/board.sqlite
# TASKD_RUNTIME_POINTER=/absolute/path/to/runtime.json
# TASKD_HOST=0.0.0.0
# TASKD_PORT=9527
# TASKD_NO_AUTOSTART=1

# Server policy. The Access panel writes these keys on save.
# TASKD_ALLOW_LIST_ENABLED=true
# TASKD_ALLOW_CIDRS=192.168.0.0/16,10.0.0.0/8
# TASKD_ACCEPTANCE_POLICY=both
# TASKD_LABEL_GC=on
# TASKD_LABEL_TTL_DAYS=30

# Identity: the platform (`--actor-kind`) is per host and is injected by the
# shim; it must not be written here. The agent name is only a default — a team
# passes `--agent jobs` / `--agent linus` / `--agent turing` per call.
# TASKCTL_AGENT=claude
# TASKCTL_HUMAN=Your Name

# Project map for `taskctl project dir`.
# MEERKAT_TASKPANEL_PROJECTS_JSON=/absolute/path/to/projects.json
