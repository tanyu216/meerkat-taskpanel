# Meerkat TaskPanel host configuration — generated by `install.sh`.
#
# Read by the host-local supervisor copy at
# `<host>/meerkat-taskpanel/scripts/supervisor.mjs`. A command-line flag or the
# process environment overrides any key below.
#
#   MEERKAT_TASKPANEL_CLAIM_UNASSIGNED      yes|no — also claim unassigned cards
#   MEERKAT_TASKPANEL_RECOVER_STALE         yes|no — also recover stale in_progress claims
#                                           (same holder 30 min, any agent 6 h)
#   MEERKAT_TASKPANEL_REPO                  where the board engine (`taskctl`) lives
#   MEERKAT_TASKPANEL_WORKFLOW              yes|no — run the review workflow pass
#   MEERKAT_TASKPANEL_AUTO_ACCEPT_REVIEWS   yes|no — close a review card after applying
#                                           its verdict; `no` leaves it for a human
#   MEERKAT_TASKPANEL_REVIEWER              the independent reviewer; empty = no dispatch
#   MEERKAT_TASKPANEL_ACCEPTANCE_POLICY     human-only|both|agent-only — advisory; the
#                                           board's install-root .env decides
#   MEERKAT_TASKPANEL_PING_INTERVAL         seconds, default 60 (liveness; no board read)
#   MEERKAT_TASKPANEL_CONTINUE_INTERVAL     seconds, default 600 (judgment clock)
#   MEERKAT_TASKPANEL_CONTINUE              yes|no — enable the continue turn
#
# The resident session pool (`--session`, the session unit):
#   MEERKAT_TASKPANEL_RESIDENT              auto|no — use a live pool for continue;
#                                           `no` never dispatches workers
#   MEERKAT_TASKPANEL_SESSION_MAX_AGE       seconds, default 86400; 0 = never expire
#   MEERKAT_TASKPANEL_SESSION_TURN_TIMEOUT  seconds, default 1800 (one turn)
#   MEERKAT_TASKPANEL_SESSION_POLL_MS       queue poll interval, default 1000
#   MEERKAT_TASKPANEL_SESSION_POOL_MAX      max project sessions, default 8
#   MEERKAT_TASKPANEL_PROJECT_CONCURRENCY   live subagents per project; unset = --max-concurrency
#   MEERKAT_TASKPANEL_PROJECT_IDLE_MS       default 1800000 (30 min); close an idle project session
#   MEERKAT_TASKPANEL_SUBAGENT_BACKGROUND   yes|no — project sessions spawn background subagents
#
# FULL TOOL ACCESS IS OFF BY DEFAULT. Turning it on gives every control, project
# and subagent session the installing user's full OS permissions; the project
# directory is not an isolation boundary. Set BOTH keys deliberately:
#   MEERKAT_TASKPANEL_ALLOW_ALL_TOOLS=yes
#   MEERKAT_TASKPANEL_ALLOW_ALL_TOOLS_REASON="<who authorized it and why>"
#
# The repo path is recorded because the body is copied into the host while the
# board engine stays in the checkout. Re-running `install.sh` re-points this key;
# a loaded unit needs no reload.
MEERKAT_TASKPANEL_CLAIM_UNASSIGNED={{CLAIM_UNASSIGNED}}
MEERKAT_TASKPANEL_RECOVER_STALE={{RECOVER_STALE}}
MEERKAT_TASKPANEL_REPO={{REPO}}
MEERKAT_TASKPANEL_WORKFLOW={{WORKFLOW}}
MEERKAT_TASKPANEL_AUTO_ACCEPT_REVIEWS={{AUTO_ACCEPT_REVIEWS}}
MEERKAT_TASKPANEL_REVIEWER={{REVIEWER}}
MEERKAT_TASKPANEL_ACCEPTANCE_POLICY={{ACCEPTANCE_POLICY}}
MEERKAT_TASKPANEL_PING_INTERVAL={{PING_INTERVAL}}
MEERKAT_TASKPANEL_CONTINUE_INTERVAL={{CONTINUE_INTERVAL}}
MEERKAT_TASKPANEL_CONTINUE={{CONTINUE}}
MEERKAT_TASKPANEL_RESIDENT=auto
MEERKAT_TASKPANEL_SESSION_MAX_AGE=86400
MEERKAT_TASKPANEL_SESSION_TURN_TIMEOUT=1800
MEERKAT_TASKPANEL_SESSION_POLL_MS=1000
MEERKAT_TASKPANEL_SESSION_POOL_MAX=8
MEERKAT_TASKPANEL_PROJECT_IDLE_MS=1800000
MEERKAT_TASKPANEL_SUBAGENT_BACKGROUND=no
