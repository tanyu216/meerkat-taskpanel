# Meerkat TaskPanel supervisor — generated by `install.sh`.
#
# ping every minute: drop registry entries whose worker pid is gone. No board
# read, no claim, no LLM.
# continue every {{CONTINUE_INTERVAL}}s: wake the agent with a `Continue` prompt; that
# turn runs patrol → workflow → poll. Logs append to {{LOG}}.
#
# Load with:  crontab <scheduling>/cron/meerkat-taskpanel.cron
#
# Each job names the ABSOLUTE node that rendered this file; `env node` would
# resolve against cron's minimal PATH and exit 127. The PATH= setting line below
# covers everything a tick derives (the agent CLI and the worker's own tree).
# Both are version-pinned: after a node or CLI upgrade, run
# `install.sh --force` and re-run `crontab`.

PATH={{UNIT_PATH_CRON}}

{{PING_CRON}} {{NODE}} {{CLI}} loop run --ping-once --actor-kind {{ACTOR_KIND}} --log {{LOG}} --state-dir {{STATE_DIR}} >/dev/null 2>&1
{{CONTINUE_CRON}} {{NODE}} {{CLI}} loop run --continue-once --actor-kind {{ACTOR_KIND}} --log {{LOG}} --state-dir {{STATE_DIR}} >/dev/null 2>&1
