# Task Panel supervisor — generated by `install.sh`.
#
# The poll layer runs every minute (a $0 candidate scan; a worker is woken only
# when a card was claimed). The patrol layer runs every five minutes (escalate
# stale claims; report an unreadable heartbeat; no LLM turn by default).
#
# Load with:  crontab <scheduling>/cron/taskpanel.cron
# Logs append to {{LOG}}.

* * * * * /usr/bin/env node {{SUPERVISOR}} --host {{HOST}} --agent {{AGENT}} --once --log {{LOG}} --state {{STATE}} >/dev/null 2>&1
*/5 * * * * /usr/bin/env node {{SUPERVISOR}} --host {{HOST}} --agent {{AGENT}} --patrol-only --once --log {{LOG}} --state {{STATE}} >/dev/null 2>&1
