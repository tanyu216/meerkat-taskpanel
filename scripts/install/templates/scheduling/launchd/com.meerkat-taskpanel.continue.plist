<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Meerkat TaskPanel continue unit — generated by `install.sh`. Wakes the agent kind's
     headless agent every {{CONTINUE_INTERVAL}} seconds with a `Continue` prompt; that turn
     runs patrol → workflow → poll. Load it with launchctl; nothing is loaded
     automatically. Logs append to {{LOG}}.

     ProgramArguments[0] is the ABSOLUTE node that rendered this plist; `env node`
     would resolve against launchd's minimal PATH and exit 127. The PATH below also
     carries the agent CLI's directory, which the continue turn starts by name. After
     a node or CLI upgrade, run `install.sh --force` to refresh this plist. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.meerkat-taskpanel.{{AGENT}}.{{ACTOR_KIND}}.continue</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE}}</string>
    <string>{{CLI}}</string>
    <string>loop</string>
    <string>run</string>
    <string>--continue-once</string>
    <string>--actor-kind</string>
    <string>{{ACTOR_KIND}}</string>
    <string>--agent</string>
    <string>{{AGENT}}</string>
    <string>--log</string>
    <string>{{LOG}}</string>
    <string>--state-dir</string>
    <string>{{STATE_DIR}}</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{UNIT_PATH_LAUNCHD}}</string>
  </dict>
  <key>StartInterval</key>
  <integer>{{CONTINUE_INTERVAL}}</integer>
  <key>RunAtLoad</key>
  <false/>
  <!-- No StandardOutPath/StandardErrorPath: the loop writes --log itself.
       A redirect into the same file would duplicate every line. -->
</dict>
</plist>
