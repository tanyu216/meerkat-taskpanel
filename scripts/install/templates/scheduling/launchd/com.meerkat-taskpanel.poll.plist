<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Meerkat TaskPanel poll unit — generated by `install.sh`. Runs one supervisor tick a
     minute: a $0 candidate scan, an atomic claim, and a worker wake only when a
     card was actually claimed. `install.sh` prints the launchctl command to load
     it; nothing is loaded automatically. Logs append to {{LOG}}. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.meerkat-taskpanel.{{AGENT}}.{{HOST}}.poll</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>{{SUPERVISOR}}</string>
    <string>--host</string>
    <string>{{HOST}}</string>
    <string>--agent</string>
    <string>{{AGENT}}</string>
    <string>--once</string>
    <string>--log</string>
    <string>{{LOG}}</string>
    <string>--state</string>
    <string>{{STATE}}</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>{{LOG}}</string>
  <key>StandardErrorPath</key>
  <string>{{LOG}}</string>
</dict>
</plist>
