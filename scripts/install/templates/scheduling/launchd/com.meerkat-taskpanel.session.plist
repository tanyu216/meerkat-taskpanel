<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Meerkat TaskPanel resident session pool — generated by `install.sh`.
     One long-lived manager owns the supervisor's agent conversations: one worker
     session per card, a reviewer lane per directory and a director lane per project.
     The tick clock runs patrol/workflow/poll in place; poll claims cards and writes
     handoffs to the queue, and the matching session opens the worker/reviewer on the
     role's platform with the card's workspace as its cwd. Without it the tick still
     runs patrol + workflow, but claims nothing.
     `KeepAlive` is the recovery story; project sessions are resumed on demand.
     Full tool access is opt-in through the per-kind config
     (MEERKAT_TASKPANEL_ALLOW_ALL_TOOLS + ..._REASON), never a flag here.
     Logs append to {{LOG}}. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.meerkat-taskpanel.{{AGENT}}.{{ACTOR_KIND}}.session</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE}}</string>
    <string>{{CLI}}</string>
    <string>loop</string>
    <string>session</string>
    <string>--actor-kind</string>
    <string>{{ACTOR_KIND}}</string>
    <string>--log</string>
    <string>{{LOG}}</string>
    <string>--state-dir</string>
    <string>{{STATE_DIR}}</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{UNIT_PATH_LAUNCHD}}</string>
  </dict>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <!-- No StandardOutPath/StandardErrorPath: the loop writes --log itself.
       A redirect into the same file would duplicate every line. -->
</dict>
</plist>
