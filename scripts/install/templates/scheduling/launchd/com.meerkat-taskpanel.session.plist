<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Meerkat TaskPanel resident session pool — generated by `install.sh`.
     One long-lived manager owns the loop's host conversations: a control session
     in the taskpanel checkout (it runs the `/meerkat-loop` continue turn) plus one
     project session per target directory. The continue timer enqueues its turn
     here; poll claims cards and writes handoffs to the queue, and the project
     session spawns the worker/reviewer subagent with the project directory as its
     cwd. Without it the loop still runs patrol + workflow, but claims nothing.
     `KeepAlive` is the recovery story; project sessions are resumed on demand.
     Full tool access is opt-in through the host config
     (MEERKAT_TASKPANEL_ALLOW_ALL_TOOLS + ..._REASON), never a flag here.
     Logs append to {{LOG}}. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.meerkat-taskpanel.{{AGENT}}.{{HOST}}.session</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE}}</string>
    <string>{{SUPERVISOR}}</string>
    <string>--host</string>
    <string>{{HOST}}</string>
    <string>--agent</string>
    <string>{{AGENT}}</string>
    <string>--session</string>
    <string>--log</string>
    <string>{{LOG}}</string>
    <string>--state</string>
    <string>{{STATE}}</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{UNIT_PATH_LAUNCHD}}</string>
  </dict>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>{{LOG}}</string>
  <key>StandardErrorPath</key>
  <string>{{LOG}}</string>
</dict>
</plist>
