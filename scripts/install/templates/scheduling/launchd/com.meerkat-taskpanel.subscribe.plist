<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Meerkat TaskPanel event subscriber — generated by `install.sh`.
     Holds one SSE connection to the board and asks for a continue turn when a
     dispatch-relevant event arrives. The ping/continue clocks stay installed
     beside it: they remain the fallback, and the only path for time-based work
     (stale claims, review aging, SLA tiers).

     `KeepAlive` restarts the process if the connection layer gives up; the
     process itself reconnects with backoff, so a restart is the last resort,
     not the normal recovery path. `install.sh` prints the launchctl command;
     nothing is loaded automatically. Logs append to {{LOG}}. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.meerkat-taskpanel.{{AGENT}}.{{HOST}}.subscribe</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE}}</string>
    <string>{{SUPERVISOR}}</string>
    <string>--host</string>
    <string>{{HOST}}</string>
    <string>--agent</string>
    <string>{{AGENT}}</string>
    <string>--subscribe</string>
    <string>--log</string>
    <string>{{LOG}}</string>
    <string>--state</string>
    <string>{{STATE}}</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{UNIT_PATH_LAUNCHD}}</string>
  </dict>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>{{LOG}}</string>
  <key>StandardErrorPath</key>
  <string>{{LOG}}</string>
</dict>
</plist>
