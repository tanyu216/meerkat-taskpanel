<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Meerkat TaskPanel event subscriber — generated by `install.sh`.
     Follows the local event hub through `taskctl events follow` and asks for a
     continue turn when a dispatch-relevant event arrives. The ping/continue clocks stay installed beside it: they are the
     fallback and the only path for time-based work. `KeepAlive` is the last resort;
     the process reconnects with backoff on its own. Logs append to {{LOG}}. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.meerkat-taskpanel.{{AGENT}}.{{ACTOR_KIND}}.subscribe</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE}}</string>
    <string>{{CLI}}</string>
    <string>loop</string>
    <string>subscribe</string>
    <string>--actor-kind</string>
    <string>{{ACTOR_KIND}}</string>
    <string>--agent</string>
    <string>{{AGENT}}</string>
    <string>--log</string>
    <string>{{LOG}}</string>
    <string>--state-dir</string>
    <string>{{STATE_DIR}}</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{UNIT_PATH_LAUNCHD}}</string>
  </dict>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>{{LOG}}</string>
  <key>StandardErrorPath</key>
  <string>{{LOG}}</string>
</dict>
</plist>
