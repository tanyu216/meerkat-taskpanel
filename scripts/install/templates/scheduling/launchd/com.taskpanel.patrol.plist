<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Task Panel patrol unit — generated by `install.sh`. Runs one supervisor patrol
     pass every five minutes: stale in_progress claims are escalated and an
     unreadable heartbeat is reported. No LLM turn by default. `install.sh` prints
     the launchctl command to load it; nothing is loaded automatically. Logs append
     to {{LOG}}. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.taskpanel.{{AGENT}}.{{HOST}}.patrol</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>{{SUPERVISOR}}</string>
    <string>--host</string>
    <string>{{HOST}}</string>
    <string>--agent</string>
    <string>{{AGENT}}</string>
    <string>--patrol-only</string>
    <string>--once</string>
    <string>--log</string>
    <string>{{LOG}}</string>
    <string>--state</string>
    <string>{{STATE}}</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>{{LOG}}</string>
  <key>StandardErrorPath</key>
  <string>{{LOG}}</string>
</dict>
</plist>
