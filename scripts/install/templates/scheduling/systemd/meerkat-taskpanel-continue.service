# Meerkat TaskPanel continue service — generated by `install.sh`.
#
# One judgment turn: wake the host's headless agent with a bounded `继续`
# prompt. That turn runs the deterministic loop entries
# (patrol → workflow → poll). Driven by meerkat-taskpanel-continue.timer
# ({{CONTINUE_INTERVAL}}s).
[Unit]
Description=Meerkat TaskPanel supervisor continue turn ({{AGENT}} on {{HOST}})

[Service]
Type=oneshot
ExecStart=/usr/bin/env node {{SUPERVISOR}} --host {{HOST}} --agent {{AGENT}} --continue-only --once --log {{LOG}} --state {{STATE}}
StandardOutput=append:{{LOG}}
StandardError=append:{{LOG}}
