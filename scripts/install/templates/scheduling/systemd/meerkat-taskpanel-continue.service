# Meerkat TaskPanel continue service — generated by `install.sh`.
#
# One judgment turn: wake the agent kind's headless CLI with a bounded `Continue`
# prompt. That turn runs the deterministic passes
# (patrol → workflow → poll). Driven by meerkat-taskpanel-continue.timer
# ({{CONTINUE_INTERVAL}}s).
[Unit]
Description=Meerkat TaskPanel supervisor continue turn ({{AGENT}} on {{ACTOR_KIND}})

[Service]
Type=oneshot
ExecStart={{NODE}} {{CLI}} loop run --continue-once --actor-kind {{ACTOR_KIND}} --agent {{AGENT}} --log {{LOG}} --state-dir {{STATE_DIR}}
# No stdout/stderr redirect: the loop writes --log itself (with rotation).
# A redirect into the same file would duplicate every line.
