# Meerkat TaskPanel ping service — generated by `install.sh`.
#
# One ping pass: drop registry entries whose worker pid is gone. It reads no
# board, claims no card and starts no LLM turn. Driven by
# meerkat-taskpanel-ping.timer ({{PING_INTERVAL}}s).
#
# Install the user unit, then enable it:
#   mkdir -p ~/.config/systemd/user
#   cp <scheduling>/systemd/* ~/.config/systemd/user/
#   systemctl --user enable --now meerkat-taskpanel-ping.timer
[Unit]
Description=Meerkat TaskPanel supervisor ping ({{AGENT}} on {{ACTOR_KIND}})

[Service]
Type=oneshot
ExecStart={{NODE}} {{CLI}} loop run --ping-once --actor-kind {{ACTOR_KIND}} --agent {{AGENT}} --log {{LOG}} --state-dir {{STATE_DIR}}
StandardOutput=append:{{LOG}}
StandardError=append:{{LOG}}
