# Meerkat TaskPanel ping timer — generated by `install.sh`. Fires the ping service
# every {{PING_INTERVAL}} seconds (the liveness clock; no board, no LLM).
[Unit]
Description=Meerkat TaskPanel ping timer (every {{PING_INTERVAL}}s)

[Timer]
OnBootSec=30s
OnUnitActiveSec={{PING_INTERVAL}}s
Unit=meerkat-taskpanel-ping.service

[Install]
WantedBy=timers.target
