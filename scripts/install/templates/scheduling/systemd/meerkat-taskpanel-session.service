# Meerkat TaskPanel resident session pool — generated by `install.sh`.
#
# One long-lived manager owns the loop's agent conversations: a control session in
# the taskpanel checkout (it runs the `/meerkat-loop` continue turn), one worker
# session per target directory, and a reviewer session in the same directory when a
# review card is queued. The continue timer enqueues its turn here; poll claims
# cards and writes handoffs to the queue, and the matching session spawns the
# worker/reviewer subagent with the project directory as its cwd.
#
# Without this unit the loop still runs patrol + workflow on the continue timer,
# but claims nothing: there is nowhere to dispatch a worker, so dispatch is
# paused and one `--notify` alert is emitted per cadence.
#
# `Type=simple` + `Restart=always` is the unit's recovery story. A project
# session is re-opened (and resumed) on demand; the ledger records unfinished
# subagents so they can be reattached.
#
# Full tool access is opt-in through the agent config — never a flag here:
#   MEERKAT_TASKPANEL_ALLOW_ALL_TOOLS=yes
#   MEERKAT_TASKPANEL_ALLOW_ALL_TOOLS_REASON="<who authorized it and why>"
# With it, every session runs with the installing user's full OS permissions;
# the project directory is not an isolation boundary.
[Unit]
Description=Meerkat TaskPanel resident session pool ({{AGENT}} on {{ACTOR_KIND}})
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/env node {{SUPERVISOR}} --actor-kind {{ACTOR_KIND}} --agent {{AGENT}} --session --log {{LOG}} --state {{STATE}}
Restart=always
RestartSec=5
StandardOutput=append:{{LOG}}
StandardError=append:{{LOG}}

[Install]
WantedBy=default.target
