# Meerkat TaskPanel event subscriber — generated by `install.sh`.
#
# Holds one SSE connection to the board and asks for a continue turn when a
# dispatch-relevant event arrives. The ping/continue timers stay enabled beside
# it: they remain the fallback, and the only path for time-based work (stale
# claims, review aging, SLA tiers).
#
# `Type=simple` + `Restart=always` is the unit's recovery story; the process
# also reconnects with backoff, so a restart is the last resort.
[Unit]
Description=Meerkat TaskPanel event subscriber ({{AGENT}} on {{HOST}})

[Service]
Type=simple
ExecStart=/usr/bin/env node {{SUPERVISOR}} --host {{HOST}} --agent {{AGENT}} --subscribe --log {{LOG}} --state {{STATE}}
Restart=always
RestartSec=5
StandardOutput=append:{{LOG}}
StandardError=append:{{LOG}}

[Install]
WantedBy=default.target
