# Task Panel poll service — generated by `install.sh`.
#
# One supervisor tick: a $0 candidate scan, an atomic claim, and a worker wake
# only when a card was claimed. Driven by taskpanel-poll.timer (every 60s).
#
# Install the user unit, then enable it:
#   mkdir -p ~/.config/systemd/user
#   cp <scheduling>/systemd/* ~/.config/systemd/user/
#   systemctl --user enable --now taskpanel-poll.timer
[Unit]
Description=Task Panel supervisor poll tick ({{AGENT}} on {{HOST}})

[Service]
Type=oneshot
ExecStart=/usr/bin/env node {{SUPERVISOR}} --host {{HOST}} --agent {{AGENT}} --once --log {{LOG}} --state {{STATE}}
StandardOutput=append:{{LOG}}
StandardError=append:{{LOG}}
