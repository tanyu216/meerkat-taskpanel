# Task Panel poll timer — generated by `install.sh`. Fires the poll service every
# minute (the cheap scan; a wake happens only when a card is claimed).
[Unit]
Description=Task Panel poll timer (every 60s)

[Timer]
OnBootSec=30s
OnUnitActiveSec=60s
Unit=taskpanel-poll.service

[Install]
WantedBy=timers.target
