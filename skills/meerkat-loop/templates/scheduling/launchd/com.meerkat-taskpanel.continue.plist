<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Meerkat TaskPanel continue unit — generated by `install.sh`. Wakes the host's
     headless agent every {{CONTINUE_INTERVAL}} seconds with a `继续` prompt; that turn
     runs patrol → workflow → poll. Load it with launchctl; nothing is loaded
     automatically. Logs append to {{LOG}}.

     ProgramArguments[0] is the ABSOLUTE node that rendered this plist; `env node`
     would resolve against launchd's minimal PATH and exit 127. The PATH below also
     carries the host CLI's directory, which the continue turn starts by name. After
     a node or CLI upgrade, run `install.sh --force` to refresh this plist. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.meerkat-taskpanel.{{AGENT}}.{{HOST}}.continue</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE}}</string>
    <string>{{SUPERVISOR}}</string>
    <string>--host</string>
    <string>{{HOST}}</string>
    <string>--agent</string>
    <string>{{AGENT}}</string>
    <string>--continue-only</string>
    <string>--once</string>
    <string>--log</string>
    <string>{{LOG}}</string>
    <string>--state</string>
    <string>{{STATE}}</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{UNIT_PATH_LAUNCHD}}</string>
  </dict>
  <key>StartInterval</key>
  <integer>{{CONTINUE_INTERVAL}}</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>{{LOG}}</string>
  <key>StandardErrorPath</key>
  <string>{{LOG}}</string>
</dict>
</plist>
