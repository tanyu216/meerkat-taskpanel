<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Meerkat TaskPanel continue unit — generated by `install.sh`. Wakes the host's
     headless agent every {{CONTINUE_INTERVAL}} seconds with a bounded `继续` prompt.
     That turn runs the deterministic loop entries (patrol → workflow → poll).
     `install.sh` prints the launchctl command to load it; nothing is loaded
     automatically. Logs append to {{LOG}}.

     ProgramArguments[0] is the ABSOLUTE node that rendered this plist — never
     `/usr/bin/env node`, which launchd resolves against the job's PATH
     (`/usr/bin:/bin:/usr/sbin:/sbin`, holding no nvm and no Homebrew directory) and
     which therefore exits 127 on any machine whose node lives only there. PATH below
     also carries the host CLI's directory: the continue turn starts that CLI by name.
     It prepends those directories to launchd's default rather than replacing it, so
     a child that asks for `sh` or `git` still finds them. Both are version-pinned:
     after a node or CLI upgrade, run `install.sh --force` to refresh this plist. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.meerkat-taskpanel.{{AGENT}}.{{HOST}}.continue</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE}}</string>
    <string>{{SUPERVISOR}}</string>
    <string>--host</string>
    <string>{{HOST}}</string>
    <string>--agent</string>
    <string>{{AGENT}}</string>
    <string>--continue-only</string>
    <string>--once</string>
    <string>--log</string>
    <string>{{LOG}}</string>
    <string>--state</string>
    <string>{{STATE}}</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{UNIT_PATH_LAUNCHD}}</string>
  </dict>
  <key>StartInterval</key>
  <integer>{{CONTINUE_INTERVAL}}</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>{{LOG}}</string>
  <key>StandardErrorPath</key>
  <string>{{LOG}}</string>
</dict>
</plist>
