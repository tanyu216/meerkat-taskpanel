<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Meerkat TaskPanel ping unit — generated by `install.sh`. Runs one ping pass
     every {{PING_INTERVAL}} seconds: drops registry entries whose worker pid is gone.
     No board read, no claim, no LLM. Load it with launchctl; nothing is loaded
     automatically. Logs append to {{LOG}}.

     ProgramArguments[0] is the ABSOLUTE node that rendered this plist; `env node`
     would resolve against launchd's minimal PATH and exit 127. The PATH below does
     the same for everything a tick derives (the agent CLI, the worker's own tree).
     After a node or CLI upgrade, run `install.sh --force` to refresh this plist. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.meerkat-taskpanel.{{AGENT}}.{{ACTOR_KIND}}.ping</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE}}</string>
    <string>{{SUPERVISOR}}</string>
    <string>--actor-kind</string>
    <string>{{ACTOR_KIND}}</string>
    <string>--agent</string>
    <string>{{AGENT}}</string>
    <string>--ping-only</string>
    <string>--once</string>
    <string>--log</string>
    <string>{{LOG}}</string>
    <string>--state</string>
    <string>{{STATE}}</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{UNIT_PATH_LAUNCHD}}</string>
  </dict>
  <key>StartInterval</key>
  <integer>{{PING_INTERVAL}}</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>{{LOG}}</string>
  <key>StandardErrorPath</key>
  <string>{{LOG}}</string>
</dict>
</plist>
