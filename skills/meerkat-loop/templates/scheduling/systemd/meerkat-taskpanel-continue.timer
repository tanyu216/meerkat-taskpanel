# Meerkat TaskPanel continue timer — generated by `install.sh`. Fires the continue
# service every {{CONTINUE_INTERVAL}} seconds (the judgment clock).
[Unit]
Description=Meerkat TaskPanel continue timer (every {{CONTINUE_INTERVAL}}s)

[Timer]
OnBootSec=120s
OnUnitActiveSec={{CONTINUE_INTERVAL}}s
Unit=meerkat-taskpanel-continue.service

[Install]
WantedBy=timers.target
