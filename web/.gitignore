# Frontend build/runtime output — never committed.
node_modules/
dist/

# The vendored npm cache at .vendor/npm-cache IS committed on purpose (F1-c, ruling O1,
# 2026-10-09): the image's `webbuild` stage installs the frontend from it fully offline
# (`npm ci --offline`, so `docker build --network=none` succeeds). Do not add `.vendor`
# here. It is a generated artefact (linux/arm64) — re-vendor it after any dependency bump;
# see docs/docker.md.
!.vendor/
